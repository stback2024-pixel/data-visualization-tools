# Jupyter Notebook Example for Data Visualization Tool
# Import necessary libraries
import pandas as pd
import matplotlib.pyplot as plt
from ipywidgets import interact, widgets

# Load sample data
sample_data = pd.read_csv('https://raw.githubusercontent.com/stback2024-pixel/data-visualization-tools/main/datasets/sample_dataset.csv')

# Function to plot interactive graphs
@interact(x=widgets.Select(options=['Column1', 'Column2'], value='Column1'), y=widgets.Select(options=['Column3', 'Column4'], value='Column3'))
def plot_interactive_graph(x, y):
    plt.figure()
    sample_data.plot(kind='line', x=x, y=y)
    plt.title('Interactive Plot of {} vs {}'.format(y, x))
    plt.show()