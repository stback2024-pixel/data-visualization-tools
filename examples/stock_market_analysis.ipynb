# Jupyter Notebook Example for Stock Market Analysis
# Import necessary libraries
import pandas as pd
from bokeh.plotting import figure, show
from bokeh.io import output_notebook
output_notebook()
# Load stock market data
data = pd.read_csv('https://raw.githubusercontent.com/stback2024-pixel/data-visualization-tools/main/datasets/stock_market_data.csv')
# Visualize the stock prices over time
p = figure(title='Stock Market Analysis', x_axis_label='Date', y_axis_label='Price')
p.line(data['date'], data['price'], legend_label='Stock Price', line_width=2)
show(p)